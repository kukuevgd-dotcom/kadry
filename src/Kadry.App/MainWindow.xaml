<Window x:Class="Kadry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кадры — кадровый учёт" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="#F9FAFB">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Margin="8,8,8,16">
                    <TextBlock Text="Кадры" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="кадровый учёт" FontSize="12" Foreground="#6B7280" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8">
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UserRole}" FontSize="12" Foreground="#6B7280" />
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource MenuButton}" Content="Панель"
                            Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                    <Button Style="{StaticResource MenuButton}" Content="Сотрудники"
                            Command="{Binding NavigateCommand}" CommandParameter="Employees" />
                    <Button Style="{StaticResource MenuButton}" Content="Заявления на отпуск"
                            Command="{Binding NavigateCommand}" CommandParameter="Requests" />
                    <Button Style="{StaticResource MenuButton}" Content="График отпусков"
                            Command="{Binding NavigateCommand}" CommandParameter="Schedule" />
                    <Button Style="{StaticResource MenuButton}" Content="Справочники"
                            Command="{Binding NavigateCommand}" CommandParameter="Directories" />
                    <Button Style="{StaticResource MenuButton}" Content="Отчёты"
                            Command="{Binding NavigateCommand}" CommandParameter="Reports" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding SectionTitle}"
                       FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <TextBlock Text="Раздел в разработке"
                           Foreground="#9CA3AF" FontSize="15" />
            </Border>
        </Grid>
    </Grid>
</Window>
