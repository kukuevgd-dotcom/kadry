<UserControl x:Class="Kadry.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Width="220">
                <StackPanel>
                    <TextBlock Text="{Binding PendingCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="заявлений в ожидании" Style="{StaticResource CardLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="220">
                <StackPanel>
                    <TextBlock Text="{Binding MonthVacationCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="отпусков в этом месяце" Style="{StaticResource CardLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="220">
                <StackPanel>
                    <TextBlock Text="{Binding ActiveEmployeeCount}" Style="{StaticResource CardValue}" />
                    <TextBlock Text="сотрудников" Style="{StaticResource CardLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource CardValue}" FontSize="18" />
                    <TextBlock Text="текущий месяц" Style="{StaticResource CardLabel}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="Заявления в ожидании"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding PendingRequests}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="60" />
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee}" Width="2*" />
                        <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="1.5*" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock DockPanel.Dock="Top" Text="Отпуска текущего месяца"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding MonthVacations}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee}" Width="2*" />
                        <DataGridTextColumn Header="Вид" Binding="{Binding TypeName}" Width="1.5*" />
                        <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Сотрудники по отделам"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding DepartmentCounts}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*" />
                        <DataGridTextColumn Header="Сотрудников" Binding="{Binding Count}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
