<UserControl x:Class="Kadry.App.Views.DirectoriesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Width" Value="110" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
            <Setter Property="MinHeight" Value="200" />
        </Style>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Отделы">
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource RowButton}" Content="Добавить"
                            Command="{Binding AddDepartmentCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Переименовать"
                            Command="{Binding RenameDepartmentCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Удалить"
                            Command="{Binding DeleteDepartmentCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Departments}"
                          SelectedItem="{Binding SelectedDepartment}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Должности">
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource RowButton}" Content="Добавить"
                            Command="{Binding AddPositionCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Переименовать"
                            Command="{Binding RenamePositionCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Удалить"
                            Command="{Binding DeletePositionCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding SelectedPosition}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <TabItem Header="Виды отпусков">
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource RowButton}" Content="Добавить"
                            Command="{Binding AddVacationTypeCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Изменить"
                            Command="{Binding EditVacationTypeCommand}" />
                    <Button Style="{StaticResource RowButton}" Content="Удалить"
                            Command="{Binding DeleteVacationTypeCommand}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding VacationTypes}"
                          SelectedItem="{Binding SelectedVacationType}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Лимит дней в году" Binding="{Binding YearLimitDays}" Width="*" />
                        <DataGridCheckBoxColumn Header="Без оплаты" Binding="{Binding IsUnpaid}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
