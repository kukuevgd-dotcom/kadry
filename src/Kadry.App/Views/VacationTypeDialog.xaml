<Window x:Class="Kadry.App.Views.VacationTypeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вид отпуска"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="20">
        <TextBlock Text="Название:" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,10" />

        <TextBlock Text="Годовой лимит дней (0 — без лимита):" Margin="0,0,0,4" />
        <TextBox x:Name="LimitBox" Margin="0,0,0,10" />

        <CheckBox x:Name="UnpaidBox" Content="Без сохранения заработной платы" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="#DC2626" Margin="0,0,0,8" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="ОК" Width="90" IsDefault="True" Click="OnOk" Margin="0,0,8,0" />
            <Button Content="Отмена" Width="90" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
