<UserControl x:Class="Kadry.App.Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="220" VerticalContentAlignment="Center"
                      ItemsSource="{Binding DepartmentFilters}"
                      SelectedItem="{Binding DepartmentFilter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TabControl>
            <TabItem Header="Остатки дней">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Год:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="90" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
                        <Button Content="Экспорт CSV" Width="130" Margin="16,0,0,0"
                                Command="{Binding ExportRemainingCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding RemainingRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee}" Width="2*" />
                            <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*" />
                            <DataGridTextColumn Header="Вид отпуска" Binding="{Binding VacationType}" Width="2*" />
                            <DataGridTextColumn Header="Лимит" Binding="{Binding Limit}" Width="70" />
                            <DataGridTextColumn Header="Использовано" Binding="{Binding Used}" Width="110" />
                            <DataGridTextColumn Header="Остаток" Binding="{Binding Remaining}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Движение кадров">
                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker Width="150" SelectedDate="{Binding MovementFrom}" />
                        <TextBlock Text="по:" VerticalAlignment="Center" Margin="12,0,8,0" />
                        <DatePicker Width="150" SelectedDate="{Binding MovementTo}" />
                        <Button Content="Экспорт CSV" Width="130" Margin="16,0,0,0"
                                Command="{Binding ExportMovementCommand}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding MovementRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee}" Width="2*" />
                            <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*" />
                            <DataGridTextColumn Header="Событие" Binding="{Binding Event}" Width="120" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding EventDate}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
